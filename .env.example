# MySQL
MYSQL_HOST=xxx
MYSQL_PORT=xxx
MYSQL_USER=xxx
MYSQL_PASSWORD=xxx
MYSQL_DB=xxx

# Redis
REDIS_HOST=xxx
REDIS_PORT=xxx
REDIS_PASSWORD=xxx

# RabbitMQ
RABBITMQ_HOST=xxx
RABBITMQ_DEFAULT_USER=xxx
RABBITMQ_DEFAULT_PASSWORD=xxx
RABBITMQ_NAME=xxx
RABBITMQ_PORT=xxx

# Qdrant
QDRANT_HOST=xxx
QDRANT_PORT=xxx
QDRANT_API_KEY=xxx

# =============
# 大模型通用配置
# =============
PROVIDER=custom
THINKING_ENABLED=true
SUPPORTED_THINKING=true
REASONING_EFFORT=high
METADATA={}

# 火山体验计划
LLM_API_KEY_DouBaoSeedLite=xxxxxx
LLM_BASE_URL_DouBaoSeedLite=xxx
LLM_MODEL_DouBaoSeedLite=xxx

# DeepSeek
LLM_API_KEY_DeepSeek=sk-xxx
LLM_BASE_URL_DeepSeek=xxx
LLM_BASE_MODEL_DeepSeek=xxx
LLM_DISPLAY_NAME_DeepSeek=xxx

# langfuse
LANGFUSE_ENABLED=xxx
LANGFUSE_SECRET_KEY=xxx
LANGFUSE_PUBLIC_KEY=xxx
LANGFUSE_BASE_URL=xxx

# context_editing: langchain 上下文清理中间件, 用于在上下文过大时清理历史工具调用内容
CONTEXT_EDITING_ENABLED=true
CONTEXT_EDITING_SOURCE=langchain
# token 估算方式；approximate 为近似统计，model 为按模型统计
CONTEXT_EDITING_TOKEN_COUNT_METHOD=approximate
# 达到该tokens时触发清理
CONTEXT_EDITING_CLEAR_TOOL_USES_TRIGGER=100000
# 触发后至少清理的 token 数；0 表示由中间件自行决定
CONTEXT_EDITING_CLEAR_TOOL_USES_CLEAR_AT_LEAST=0
# 保留最近多少个工具调用结果，较小值可节省上下文但会损失近期工具细节
CONTEXT_EDITING_CLEAR_TOOL_USES_KEEP=3
# 是否同时清理工具入参
CONTEXT_EDITING_CLEAR_TOOL_USES_INPUTS=false
# 不参与清理的工具名列表。
CONTEXT_EDITING_CLEAR_TOOL_USES_EXCLUDE_TOOLS=[]
# 被清理内容在上下文中的占位文本。
CONTEXT_EDITING_CLEAR_TOOL_USES_PLACEHOLDERS="[CLEARED]"

# LangChain 文件搜索中间件，让模型可在指定根目录内检索文件内容。
FILESYSTEM_FILE_SEARCH_ENABLED=true
# 搜索根目录；支持 {workspace_root} 占位符，建议限制在当前运行工作区。
FILESYSTEM_FILE_SEARCH_ROOT_PATH="{workspace_root}"
FILESYSTEM_FILE_SEARCH_USE_RIPGREP=true
# 单文件最大索引/搜索大小，避免读取超大文件。
FILESYSTEM_FILE_SEARCH_MAX_FILE_SIZE_MB=10
FILESYSTEM_FILE_SEARCH_SOURCE=langchain

# pii: 检车输入,输出或工具结果中的敏感信息, 并按规则脱敏阻断或变换
PII_ENABLED=true
PII_RULES=[]
PII_SOURCE=langchain

# jwt
JWT_SECRET_KEY=xxx
ACCESS_TOKEN_EXPIRE_MINUTES=xxx
JWT_ALGORITHM=xxx

# SMPT
SMTP_HOST=xxx
SMTP_PORT=xxx
SMTP_USER=xxx
SMTP_PASSWORD=xxx # 邮箱授权码
SMTP_FROM=xxx

LOG_DIR=/log/sea_ai